# Copy to backend/.env and edit. backend/.env is git-ignored.
#
# Parent directory that holds data/ and saved_models/ (GMDB files).
# Keep it outside the repository; the files are mounted read-only and never baked into the image.
# If unset, docker compose uses this directory (backend/), i.e. backend/data and backend/saved_models.
NGPSUITE_GMDB_DIR=/absolute/path/to/ngpsuite-gmdb

# Basic-auth credentials for /api/predict. If left empty, the placeholder your_username / your_password
# is used (a notice is printed at startup). Enter the same values in the web UI Settings dialog.
NGPSUITE_USERNAME=
NGPSUITE_PASSWORD=

# Address on which the service is published. Default 127.0.0.1 (this machine only).
# Set to 0.0.0.0 to share the service on your LAN, and change the credentials above.
# Do NOT expose this service to the internet.
NGPSUITE_BIND=127.0.0.1

# Host port for HTTPS. Default 443 (https://localhost). On macOS, publishing 127.0.0.1:443 needs Docker Desktop's
# "Allow privileged port mapping" (Settings > Advanced). Without it, use an unprivileged port, e.g. 8443,
# and open https://localhost:8443 .
NGPSUITE_PORT=443
