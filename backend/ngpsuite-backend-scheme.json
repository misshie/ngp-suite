{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NGPsuite API Response",
  "description": "Schema for the JSON response from the /api/predict endpoint.",
  "type": "object",
  "properties": {
    "model_version": {
      "type": "string",
      "description": "Version of the GestaltMatcher model used."
    },
    "gallery_version": {
      "type": "string",
      "description": "Version of the gallery data used."
    },
    "mondo_version": {
      "type": "string",
      "description": "owl:versionInfo from the bundled Mondo international OBO release (e.g. 2026-07-06)."
    },
    "nando_ids": {
      "type": "object",
      "description": "MONDO ID to NANDO ID list map for IDs present in this response (from OBO xref: NANDO:).",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^NANDO:[0-9]+$"
        }
      }
    },
    "suggested_genes_list": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/geneEntry"
      }
    },
    "suggested_syndromes_list": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/syndromeEntry"
      }
    },
    "suggested_patients_list": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/patientEntry"
      }
    },
    "queried_hpo_ids": {
      "type": "array",
      "description": "The list of HPO IDs used in the query, if provided.",
      "items": {
        "type": "string",
        "pattern": "^HP:[0-9]{7}$"
      }
    },
    "pubcasefinder": {
      "$ref": "#/$defs/pubCaseFinderResult"
    },
    "feature_vectors": {
      "type": "array",
      "description": "Optional experimental GestaltMatcher-Arc feature vectors (one entry per model, typically 512-dim).",
      "items": {
        "$ref": "#/$defs/featureVectorEntry"
      }
    }
  },
  "required": [
    "model_version",
    "gallery_version",
    "suggested_genes_list",
    "suggested_syndromes_list",
    "suggested_patients_list"
  ],
  "$defs": {
    "featureVectorEntry": {
      "type": "object",
      "properties": {
        "model": { "type": "string", "description": "Model identifier, e.g. m0, m1, m2." },
        "dim": { "type": "integer", "description": "Feature vector dimensionality." },
        "representations": {
          "type": "array",
          "description": "Feature vector values.",
          "items": { "type": "number" }
        }
      },
      "required": ["model", "dim", "representations"]
    },
    "geneEntry": {
      "type": "object",
      "properties": {
        "gene_name": { "type": "string" },
        "gene_entrez_id": { "type": "string" },
        "distance": { "type": "number" },
        "score": { "type": ["number", "null"] },
        "gm_rank": { "type": "integer" },
        "pubcasefinder_rank": { "type": ["integer", "null"] },
        "pubcasefinder_score": { "type": ["number", "null"] },
        "mean_rank": { "type": ["number", "null"] },
        "meta_rank": { "type": "integer" }
      },
      "required": ["gene_name", "gene_entrez_id", "distance", "score", "gm_rank", "meta_rank"]
    },
    "mondoTerm": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^MONDO:[0-9]{7}$" },
        "name": { "type": "string", "description": "English label." },
        "labels": {
          "type": "object",
          "description": "Language code to display name. Always includes en; ja when MONDO has skos:altLabel @ja.",
          "additionalProperties": { "type": "string" }
        }
      },
      "required": ["id", "name"]
    },
    "syndromeEntry": {
      "type": "object",
      "properties": {
        "syndrome_name": {
          "type": "string",
          "description": "English MONDO label, or the GMDB disorder name when the disorder has no MONDO term."
        },
        "syndrome_labels": {
          "type": "object",
          "description": "Language code to display name for syndrome_name. Always includes en.",
          "additionalProperties": { "type": "string" }
        },
        "omim_id": {
          "type": ["integer", "string", "null"],
          "description": "Empty string when GMDB records no OMIM ID."
        },
        "mondo_id": {
          "type": ["string", "null"],
          "pattern": "^MONDO:[0-9]{7}$",
          "description": "Null when the disorder could not be placed in MONDO."
        },
        "mondo_parents": {
          "type": "array",
          "description": "Direct is_a parents, sorted by MONDO ID.",
          "items": { "$ref": "#/$defs/mondoTerm" }
        },
        "mondo_grandparents": {
          "type": "array",
          "description": "Parents of the parents, excluding the term itself and its direct parents, sorted by MONDO ID.",
          "items": { "$ref": "#/$defs/mondoTerm" }
        },
        "mondo_source": {
          "enum": ["omim", "gene", null],
          "description": "Whether the MONDO term was resolved from the OMIM ID or from the gene symbol."
        },
        "distance": { "type": "number" },
        "image_id": { "type": "string" },
        "subject_id": { "type": "string" },
        "ACMG_PP4": { "type": "string" },
        "ACMG_PP4_support": { "type": "string" },
        "score": { "type": ["number", "null"] },
        "gm_rank": { "type": "integer" },
        "pubcasefinder_rank": { "type": ["integer", "null"] },
        "pubcasefinder_score": { "type": ["number", "null"] },
        "mean_rank": { "type": ["number", "null"] },
        "meta_rank": { "type": "integer" }
      },
      "required": ["syndrome_name", "syndrome_labels", "omim_id", "mondo_id", "mondo_parents", "mondo_grandparents", "mondo_source", "distance", "image_id", "subject_id", "score", "gm_rank", "meta_rank"]
    },
    "patientEntry": {
      "type": "object",
      "properties": {
        "subject_id": { "type": "string" },
        "gene_name": { "type": "string" },
        "gene_entrez_id": { "type": "string" },
        "distance": { "type": "number" },
        "image_id": { "type": "string" },
        "syndrome_name": { "type": "string" },
        "omim_id": { "type": ["integer", "string"] },
        "score": { "type": ["number", "null"] },
        "gm_rank": { "type": "integer" },
        "pubcasefinder_rank": { "type": ["integer", "null"] },
        "pubcasefinder_score": { "type": ["number", "null"] },
        "mean_rank": { "type": ["number", "null"] },
        "meta_rank": { "type": "integer" },
        "numeric_omim_id": { "type": ["integer", "null"] },
        "phenotypic_series_id": { "type": ["string", "null"] },
        "mondo_id": {
          "type": "array",
          "description": "MONDO IDs of the nearest gallery image, sorted. Empty when the image has no MONDO term.",
          "items": { "type": "string", "pattern": "^MONDO:[0-9]{7}$" }
        }
      },
      "required": ["subject_id", "gene_name", "gene_entrez_id", "distance", "image_id", "syndrome_name", "omim_id", "mondo_id", "score", "gm_rank", "meta_rank"]
    },
    "pubCaseFinderResult": {
      "type": "object",
      "properties": {
        "ranked_list": {
          "type": "array",
          "items": { "$ref": "#/$defs/pcfRankedListItem" }
        },
        "hpo_names": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/hpoNameEntry" }
        }
      },
      "required": ["ranked_list", "hpo_names"]
    },
    "pcfRankedListItem": {
      "type": "object",
      "description": "NOTE: This schema is based on the assumed structure used by the integrator. It may not be exhaustive.",
      "properties": {
        "id": { "type": "string" },
        "rank": { "type": "integer" },
        "score": { "type": "number" },
        "hgnc_gene_symbol": { "type": "array", "items": { "type": "string" } },
        "mondo_id": { "type": "array", "items": { "type": "string" } },
        "omim_disease_name_en": { "type": "string" }
      }
    },
    "hpoNameEntry": {
      "type": "object",
      "properties": {
        "name_en": { "type": "string" },
        "name_ja": { "type": "string" }
      },
      "required": ["name_en", "name_ja"]
    }
  }
}
